# Example values only. Copy to .env and edit locally.
DEPLOY_APP_MAINNET_PORT="18081"
DEPLOY_APP_TESTNET_PORT="18082"
DEPLOY_COMMUNITY_DATA_DIR="/path/to/private/community-data"
DEPLOY_COMMUNITY_PORT="18083"
DEPLOY_EDGE_MAINNET_PORT="18091"
DEPLOY_EDGE_TESTNET_PORT="18092"
DEPLOY_GITHUB_APP_ID_FILE="/path/to/private/app-id"
DEPLOY_GITHUB_INSTALLATION_ID_FILE="/path/to/private/installation-id"
DEPLOY_GITHUB_PRIVATE_KEY_FILE="/path/to/private/app-key.pem"
DEPLOY_MAINNET_KEEPER_PORT="18084"
DEPLOY_MAINNET_PUBLIC_RPC_URL="https://public-rpc.mainnet.example.invalid"
DEPLOY_MAINNET_RPC_URL="https://rpc.mainnet.example.invalid"
DEPLOY_SERVICE_USER="appuser"
DEPLOY_TESTNET_API_HOST="api.testnet.example.invalid"
DEPLOY_TESTNET_KEEPER_ACTOR="keeperacct"
DEPLOY_TESTNET_KEEPER_BROADCAST="false"
DEPLOY_TESTNET_KEEPER_KEY_FILE="/path/to/private/keeper-key"
DEPLOY_TESTNET_KEEPER_PERMISSION="active"
DEPLOY_TESTNET_KEEPER_PORT="18085"
DEPLOY_TESTNET_RPC_AUTHORITY="rpc.testnet.example.invalid"
DEPLOY_TESTNET_RPC_URL="https://rpc.testnet.example.invalid"
DEPLOY_TLS_CERT_FILE="/path/to/tls/fullchain.pem"
DEPLOY_TLS_KEY_FILE="/path/to/tls/privkey.pem"
DEPLOY_TUNNEL_DESTINATION="tunneluser@edge.example.invalid"
DEPLOY_TUNNEL_KEY_FILE="/path/to/private/ssh-key"
DEPLOY_TUNNEL_SSH_PORT="22"
