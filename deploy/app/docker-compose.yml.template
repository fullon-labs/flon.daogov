services:
  daogov-mainnet:
    image: local/flon-daogov:${IMAGE_TAG:-latest}
    container_name: flon-daogov-mainnet
    restart: unless-stopped
    ports:
      - "127.0.0.1:${DEPLOY_APP_MAINNET_PORT}:80"
    volumes:
      - ./config.mainnet.js:/usr/share/nginx/html/config.js:ro
      - ./community-api.conf:/etc/nginx/daogov/community-api.conf:ro

  daogov-testnet:
    image: local/flon-daogov:${IMAGE_TAG:-latest}
    container_name: flon-daogov-testnet
    restart: unless-stopped
    ports:
      - "127.0.0.1:${DEPLOY_APP_TESTNET_PORT}:80"
    volumes:
      - ./config.testnet.js:/usr/share/nginx/html/config.js:ro
      - ./api.testnet.conf:/etc/nginx/daogov/api.conf:ro
      - ./community-api.conf:/etc/nginx/daogov/community-api.conf:ro

  community-api:
    image: local/flon-daogov-community-api:${IMAGE_TAG:-latest}
    container_name: flon-daogov-community-api
    restart: unless-stopped
    environment:
      PORT: "8789"
      GITHUB_OWNER: fullon-labs
      GITHUB_REPO: flon.daogov
      GITHUB_DISCUSSION_CATEGORY: General
      ALLOWED_ORIGINS: https://daogov.flon.network,https://daogov-t.flon.network
      GITHUB_APP_ID_FILE: /run/secrets/github_app_id
      GITHUB_APP_INSTALLATION_ID_FILE: /run/secrets/github_app_installation_id
      GITHUB_APP_PRIVATE_KEY_FILE: /run/secrets/github_app_private_key
      COMMUNITY_DATA_FILE: /data/community-state.json
    volumes:
      - ${DEPLOY_COMMUNITY_DATA_DIR}:/data
    secrets:
      - github_app_id
      - github_app_installation_id
      - github_app_private_key
    ports:
      - "127.0.0.1:${DEPLOY_COMMUNITY_PORT}:8789"

  daogov-keeper-mainnet:
    image: ghcr.io/fullon-labs/flon.daogov-keeper:${KEEPER_TAG:-0.2.0}
    container_name: flon-daogov-keeper-mainnet
    restart: unless-stopped
    environment:
      KEEPER_RPC_URL: ${DEPLOY_MAINNET_RPC_URL}
      KEEPER_CHAIN_ID: d4019d7d8633a337973408c6c00e5c4888933ad1b6ce10edddea8145317d8d12
      KEEPER_BROADCAST: "false"
      KEEPER_HEALTH_PORT: "8788"
    ports:
      - "127.0.0.1:${DEPLOY_MAINNET_KEEPER_PORT}:8788"

  daogov-keeper-testnet:
    image: ghcr.io/fullon-labs/flon.daogov-keeper:${KEEPER_TAG:-0.2.0}
    container_name: flon-daogov-keeper-testnet
    restart: unless-stopped
    environment:
      KEEPER_RPC_URL: ${DEPLOY_TESTNET_RPC_URL}
      KEEPER_CHAIN_ID: 18b4d5837d83a8f7203ea57cb7ab37b9cef59547ea307e70b1bf1103cb06043f
      KEEPER_BROADCAST: "${DEPLOY_TESTNET_KEEPER_BROADCAST}"
      KEEPER_SIGNER_ACTOR: ${DEPLOY_TESTNET_KEEPER_ACTOR}
      KEEPER_SIGNER_PERMISSION: ${DEPLOY_TESTNET_KEEPER_PERMISSION}
      KEEPER_PRIVATE_KEY_FILE: /run/secrets/testnet_keeper_key
      KEEPER_MAX_STEPS: "24"
      KEEPER_POLL_MS: "3600000"
      KEEPER_HEALTH_PORT: "8788"
    secrets:
      - testnet_keeper_key
    ports:
      - "127.0.0.1:${DEPLOY_TESTNET_KEEPER_PORT}:8788"

secrets:
  testnet_keeper_key:
    file: ${DEPLOY_TESTNET_KEEPER_KEY_FILE}
  github_app_id:
    file: ${DEPLOY_GITHUB_APP_ID_FILE}
  github_app_installation_id:
    file: ${DEPLOY_GITHUB_INSTALLATION_ID_FILE}
  github_app_private_key:
    file: ${DEPLOY_GITHUB_PRIVATE_KEY_FILE}
