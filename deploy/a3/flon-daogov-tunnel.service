[Unit]
Description=FLON DAO Governance reverse tunnels from a3 to sg-gw
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=richardchen
ExecStart=/usr/bin/ssh -NT \
  -i /home/richardchen/.ssh/id_rsa \
  -p 29888 \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=yes \
  -R 127.0.0.1:18101:127.0.0.1:20101 \
  -R 127.0.0.1:18102:127.0.0.1:20102 \
  thor@sg-gw.vm.nchain.me
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
