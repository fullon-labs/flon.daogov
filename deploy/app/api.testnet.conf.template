# Same-origin governance API. RPC and transaction signing remain separate.
location ^~ /rpc/ {
    proxy_pass ${DEPLOY_TESTNET_RPC_URL}/;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host ${DEPLOY_TESTNET_RPC_AUTHORITY};
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
    proxy_buffering off;
    proxy_intercept_errors off;
}

location ^~ /api/v1/daogov/ {
    resolver 127.0.0.11 ipv6=off valid=60s;
    set $daogov_api_host ${DEPLOY_TESTNET_API_HOST};
    proxy_pass https://$daogov_api_host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host ${DEPLOY_TESTNET_API_HOST};
    proxy_ssl_server_name on;
    proxy_ssl_name ${DEPLOY_TESTNET_API_HOST};
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
    proxy_buffering off;
    proxy_intercept_errors off;
}
